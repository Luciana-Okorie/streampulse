# Copy to .env and adjust if you need to run services outside Docker Compose.

# --- API (Go) ---
PORT=4002
KAFKA_BROKERS=localhost:9093
KAFKA_TOPIC=events

# --- Processor (Go) ---
WS_PORT=4003
KAFKA_GROUP_ID=streampulse-processor
REDIS_ADDR=localhost:6400
CLICKHOUSE_ADDR=localhost:9004
CLICKHOUSE_DB=streampulse

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4002
NEXT_PUBLIC_WS_URL=ws://localhost:4003/ws

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
